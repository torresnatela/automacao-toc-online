{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "SKIP_DB_TESTS",
        "SKIP_BROWSER_TESTS",
        "TOC_LIVE",
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CREDENTIALS_ENC_KEY",
        "RPA_HEADLESS",
        "RPA_STATE_DIR"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
