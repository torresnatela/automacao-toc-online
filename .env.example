# Supabase local. Este projeto usa portas deslocadas (+100) para coexistir com
# outro stack Supabase na máquina. Confirme os valores com `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key do `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key do `supabase status`>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# --- Cifra de credenciais de integração (AES-256-GCM) ---
# Chave-mestra que cifra `integration_credentials.secret_encrypted`.
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# O MESMO valor tem de existir no web (Vercel) e no host do worker — se
# divergirem, o worker não decifra o que o dashboard cifrou.
CREDENTIALS_ENC_KEY=<32 bytes em base64>

# --- Worker de RPA ---
SUPABASE_URL=http://127.0.0.1:54421
RPA_HEADLESS=true
RPA_CONCURRENCY=1
# Diretório do storageState do Playwright (cookies de sessão = credencial).
RPA_STATE_DIR=.rpa

# Só para o smoke test live (`TOC_LIVE=1`). Em produção as credenciais do
# TOConline são gravadas pelo utilizador no dashboard e ficam cifradas na BD.
TOCONLINE_USER=
TOCONLINE_PASSWORD=
