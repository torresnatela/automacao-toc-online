# Supabase local. Este projeto usa portas deslocadas (+100) para coexistir com
# outro stack Supabase na máquina. Confirme os valores com `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key do `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key do `supabase status`>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# --- Cifra de credenciais de integração (AES-256-GCM) ---
# Chave-mestra que cifra `integration_credentials.secret_encrypted`.
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# O MESMO valor tem de existir no web (Vercel) e no host do worker — se
# divergirem, o worker não decifra o que o dashboard cifrou.
CREDENTIALS_ENC_KEY=<32 bytes em base64>

# --- Worker de RPA ---
SUPABASE_URL=http://127.0.0.1:54421
RPA_HEADLESS=true
RPA_CONCURRENCY=1
# Diretório do storageState do Playwright (cookies de sessão = credencial).
RPA_STATE_DIR=.rpa

# Só para os scripts de reconhecimento (`scripts/recon-at.ts`, headed). Em
# produção as credenciais do TOConline são gravadas pelo utilizador no
# dashboard e ficam cifradas na BD — o worker resolve-as por job.
TOCONLINE_USER=
TOCONLINE_PASSWORD=

# --- Módulo 1 — guias de IVA (AT) ---
# A rota até ao Portal das Finanças é escolhida pelo operador a cada pedido, no
# dashboard: «Buscar» entra com a credencial do gabinete no acesso.gov.pt (rota
# B) e «Buscar via TOConline» usa o Acesso Direto por dentro do TOConline (rota
# A). O worker regista as duas — não há variável de rota.
# Bucket do Supabase Storage onde ficam os PDFs das guias.
DOCUMENTS_BUCKET=documents
# Ritmo mínimo entre jobs de IVA. 182 empresas a 5 s são ~30 min, de propósito:
# automatizamos o portal de um terceiro e não se martela.
AT_PACING_MS=5000
# Tentativas por empresa por dia. Três recusas de senha trancam a conta da AT.
AT_DAILY_ATTEMPT_CAP=5
# Pausa geral do acesso à AT depois de uma indisponibilidade (15 min).
AT_PORTAL_PAUSE_MS=900000
# Rota A (Acesso Direto): perfil persistente do Chromium do Playwright (guarda
# cookies do TOConline — é credencial) e a extensão TOConline Connect
# descompactada. Instale a extensão com:
#   pnpm --filter @toc/worker exec tsx scripts/install-toconline-connect.ts
# Caminhos relativos resolvem-se a partir de `apps/worker`, como RPA_STATE_DIR.
RPA_CHROME_USER_DATA_DIR=.rpa/chromium-profile
RPA_CHROME_EXTENSION_DIR=.rpa/extensions/toconline-connect

# Só para `scripts/recon-at.ts --route b` e `scripts/seed-at-session.ts`
# (headed, com um humano ao lado). Credenciais da AT do gabinete — nunca vão
# para a BD nem para argv.
AT_RECON_USER=
AT_RECON_PASSWORD=
