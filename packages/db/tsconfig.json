{
  "extends": "@toc/config/tsconfig",
  // rootDir em `packages/` (e não em `.`): os smoke tests importam as constantes
  // do Módulo 1 de `packages/core/src` por caminho relativo — @toc/db não pode
  // depender de @toc/core, porque @toc/core já depende de @toc/db. Abrange
  // core + db e deixa a raiz do monorepo de fora. O pacote é consumido como
  // TypeScript (exports apontam para ./src), nunca é compilado, portanto
  // outDir/rootDir só existem para o `tsc --noEmit`.
  "compilerOptions": { "outDir": "dist", "rootDir": ".." },
  "include": ["src", "test", "drizzle.config.ts"]
}
